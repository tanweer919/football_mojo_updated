{
  "name": "footballmojo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "FootballMojo realtime scores, news, predictions and player cards backend",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "worker:scores": "node dist/workers/scores.worker",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "seed:roster": "tsx prisma/seed-wc-roster.ts",
    "seed:leagues": "tsx prisma/seed-leagues.ts",
    "seed:wc": "tsx prisma/seed-wc-2026.ts",
    "seed:cards": "tsx prisma/seed-wc-cards.ts",
    "seed:prices": "tsx prisma/seed-card-prices.ts",
    "seed:wc-stages": "tsx prisma/seed-wc-stage-cards.ts",
    "seed:notification-prefs": "tsx prisma/seed-notification-prefs.ts",
    "seed:wc-roster": "tsx prisma/seed-wc-roster.ts",
    "seed:wc-2026": "tsx prisma/seed-wc-2026.ts",
    "refresh:photos": "tsx prisma/refresh-player-photos.ts",
    "refresh:photos:remote": "tsx scripts/refresh-photos-remote.ts",
    "admin:promote": "tsx prisma/promote-admin.ts",
    "reprice:players": "tsx prisma/reprice-players.ts",
    "ingest:form": "tsx prisma/ingest-player-form.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/platform-socket.io": "^10.3.10",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^10.3.10",
    "@prisma/client": "^5.18.0",
    "prisma": "^5.18.0",
    "axios": "^1.7.4",
    "axios-retry": "^4.4.2",
    "bullmq": "^5.12.10",
    "cache-manager": "^5.7.4",
    "cache-manager-ioredis-yet": "^2.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^12.3.1",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
