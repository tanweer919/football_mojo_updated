# Production env template for Dokploy.
# Paste into Dokploy → Application → Environment, with real values filled in.
# DO NOT commit a populated copy of this file.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Datastores ──────────────────────────────────────────────────────────────
# When using Dokploy managed databases, copy these from
# Dokploy → Databases → <name> → Connection URL.
#
# When using docker-compose.prod.full.yml (Postgres + Redis in-stack):
#   DATABASE_URL=postgresql://footballmojo:${POSTGRES_PASSWORD}@postgres:5432/footballmojo?schema=public
#   REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?schema=public
REDIS_URL=redis://:PASS@HOST:6379

# ── CORS (production) ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Flutter web build,
# admin panel, and any landing page. `*` is acceptable for the mobile
# app only, but tighten the moment a web client exists.
CORS_ORIGINS=https://pitch.app,https://admin.pitch.app

# ── api-football (realtime + fantasy + insights + seed) ─────────────────────
# WC 2026 = league id 1, season 2026.
# Two access modes (pick ONE):
#   A) direct via api-sports.io  — API_FOOTBALL_PROVIDER=direct
#   B) RapidAPI marketplace      — API_FOOTBALL_PROVIDER=rapidapi
API_FOOTBALL_PROVIDER=direct
API_FOOTBALL_KEY=replace_me
API_FOOTBALL_WC_LEAGUE_ID=1
API_FOOTBALL_WC_SEASON=2026

# Floor between seed HTTP requests (ms). The seed makes ~50 sequential calls.
# - RapidAPI free tier (30 req/min):     2500–3000 (slow seed, ~3 min)
# - RapidAPI Pro / direct Pro (≥7500/d): 0–250 (fast seed, ~30 s)
SEED_REQUEST_DELAY_MS=250

# ── Firebase Admin (push + auth token verify) ──────────────────────────────
# Base64-encode the service account JSON file:
#   base64 -i path/to/firebase-service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=replace_me_base64

# ── Live-score worker ──────────────────────────────────────────────────────
# CRITICAL: in production the api-football poller ONLY runs when WORKER_MODE=true.
# Without it, scores never refresh and nothing streams to clients. Set this on
# the instance that should own polling (a single API node, or a dedicated
# worker). Do NOT set it on more than one node or you'll double-poll the quota.
WORKER_MODE=true

# ── Polling cadences ───────────────────────────────────────────────────────
# Adaptive: live matches use LIVE, others use IDLE.
POLL_INTERVAL_LIVE_MS=15000
POLL_INTERVAL_IDLE_MS=600000
# Optional: comma-separated league IDs to scope the poller during quiet periods.
POLL_LEAGUE_IDS=

# Optional: override the api-football base URL. Auto-derived from
# API_FOOTBALL_PROVIDER unless you self-host a reverse proxy.
API_FOOTBALL_BASE=

# ── Dokploy network bridging ───────────────────────────────────────────────
# Name of the Dokploy-managed Docker network that holds managed Postgres
# + Redis. Find yours with: `docker network ls | grep dokploy`
# Common values: `dokploy-network` (newer Dokploy) or `dokploy_default`
# (older). Override only if `docker network ls` says something else.
DOKPLOY_NETWORK=dokploy-network

# ── Worker tuning ──────────────────────────────────────────────────────────
# BullMQ concurrency for the scoring worker. Default in code is 4 (safe
# for RapidAPI free 30 req/min). With a paid api-football plan and a
# beefier VM, bump to 8-12.
#   RapidAPI free (30 req/min):   4
#   RapidAPI Pro / direct Pro:    8-12
# Compose default is 8 — override here if your upstream cap is lower.
SCORING_QUEUE_CONCURRENCY=8

# ── News aggregator ────────────────────────────────────────────────────────
NEWS_RSS_FEEDS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss,https://www.skysports.com/rss/11095,https://www.espn.com/espn/rss/soccer/news,https://www.fifa.com/rss-feeds/news
NEWS_REFRESH_INTERVAL_MS=600000

# ── Optional / build metadata ──────────────────────────────────────────────
# Dokploy sets these automatically via build args if you wire them up.
BUILD_REF=
BUILD_DATE=

# ── For docker-compose.prod.full.yml only ──────────────────────────────────
# These power the in-stack Postgres + Redis. Leave blank when using
# Dokploy managed databases.
POSTGRES_USER=footballmojo
POSTGRES_PASSWORD=
POSTGRES_DB=footballmojo
REDIS_PASSWORD=
