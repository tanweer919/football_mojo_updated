NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://footballmojo:footballmojo@postgres:5432/footballmojo?schema=public
REDIS_URL=redis://redis:6379

# api-football. Powers the realtime poller, fantasy scoring, insights, predictions, seed.
# WC 2026 = league id 1, season 2026.
#
# Two access modes (pick ONE, the JSON payload is identical):
#
# A) Direct via api-sports.io (https://dashboard.api-football.com)
#    API_FOOTBALL_PROVIDER=direct
#    API_FOOTBALL_KEY=<your api-sports key>
#    API_FOOTBALL_BASE is auto-set; omit unless you self-host a proxy.
#
# B) RapidAPI marketplace (https://rapidapi.com/api-sports/api/api-football)
#    API_FOOTBALL_PROVIDER=rapidapi
#    API_FOOTBALL_KEY=<your RapidAPI key>
#    API_FOOTBALL_BASE is auto-set to https://api-football-v1.p.rapidapi.com/v3
API_FOOTBALL_PROVIDER=direct
API_FOOTBALL_KEY=your-api-football-key
API_FOOTBALL_WC_LEAGUE_ID=1
API_FOOTBALL_WC_SEASON=2026

# Floor between seed HTTP requests (ms). The seed makes ~50 sequential calls.
# - RapidAPI free tier (30 req/min):     set 2500–3000 (slow seed, ~3 min)
# - RapidAPI Pro / direct Pro (≥7500/d): set 0–250 (fast seed, ~30 s)
SEED_REQUEST_DELAY_MS=250

# Firebase Admin SDK service account JSON (base64-encoded for env safety).
FIREBASE_SERVICE_ACCOUNT_B64=

# Polling cadences (ms). Adaptive: live matches use LIVE, others use IDLE.
POLL_INTERVAL_LIVE_MS=15000
POLL_INTERVAL_IDLE_MS=600000

# Comma-separated RSS feeds for the news aggregator.
NEWS_RSS_FEEDS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss,https://www.skysports.com/rss/11095,https://www.espn.com/espn/rss/soccer/news,https://www.fifa.com/rss-feeds/news
NEWS_REFRESH_INTERVAL_MS=600000

# CORS
CORS_ORIGINS=http://localhost:3000
