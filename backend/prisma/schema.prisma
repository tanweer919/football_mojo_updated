// FootballMojo — Prisma schema
// Source of truth for matches, events, news, users, predictions, cards (sticker-album style).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE FOOTBALL DATA
// ─────────────────────────────────────────────────────────────────────────────

model Competition {
  id          String   @id              // e.g. "WC2026"
  name        String
  type        String                    // "tournament" | "league"
  season      String
  startsAt    DateTime
  endsAt      DateTime
  emblemUrl   String?
  teams       Team[]
  matches     Match[]
  groups      Group[]
  fantasyTournaments FantasyTournament[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id            String        @id @default(cuid())
  competitionId String
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String                  // "Group A"
  standings     GroupStanding[]
  @@unique([competitionId, name])
}

model GroupStanding {
  id       String @id @default(cuid())
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])
  played   Int    @default(0)
  won      Int    @default(0)
  drawn    Int    @default(0)
  lost     Int    @default(0)
  goalsFor Int    @default(0)
  goalsAg  Int    @default(0)
  points   Int    @default(0)
  position Int    @default(0)
  @@unique([groupId, teamId])
}

model Team {
  id           String     @id              // "ARG", "BRA", etc.
  competitionId String?
  competition  Competition? @relation(fields: [competitionId], references: [id])
  name         String
  shortName    String
  countryCode  String?
  crestUrl     String?
  primaryColor String?
  players      Player[]
  homeMatches  Match[]    @relation("HomeTeam")
  awayMatches  Match[]    @relation("AwayTeam")
  standings    GroupStanding[]
  @@index([competitionId])
}

model Player {
  id          String   @id              // upstream id
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  shirtNumber Int?
  position    String?                   // GK | DEF | MID | FWD
  nationality String?
  dateOfBirth DateTime?
  photoUrl    String?
  cardTemplates CardTemplate[]
  events      MatchEvent[]
  valuation   PlayerValuation?
  gameweekScores PlayerGameweekScore[]
  @@index([teamId])
}

model Match {
  id            String     @id              // upstream id
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeTeamId    String
  homeTeam      Team       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      Team       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffAt     DateTime
  status        MatchStatus @default(SCHEDULED)
  minute        Int?
  homeScore     Int        @default(0)
  awayScore     Int        @default(0)
  homePenalties Int?
  awayPenalties Int?
  stage         String?                    // GROUP_A | ROUND_OF_16 | QUARTER | SEMI | FINAL
  venue         String?
  events        MatchEvent[]
  predictions   Prediction[]
  updatedAt     DateTime   @updatedAt
  @@index([competitionId, kickoffAt])
  @@index([status])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALF_TIME
  FINISHED
  POSTPONED
  CANCELLED
}

model MatchEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  minute    Int
  type      EventType
  teamId    String?
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id])
  detail    String?                       // "Penalty", "Own goal", etc.
  createdAt DateTime @default(now())
  @@index([matchId, minute])
}

enum EventType {
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  PENALTY_MISS
  YELLOW
  RED
  SUB_IN
  SUB_OUT
  VAR
  KICKOFF
  HALFTIME
  FULLTIME
}

// ─────────────────────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String   @id              // Firebase UID
  email           String?  @unique
  displayName     String?
  /// Public handle other users search/follow by — e.g. "jordan42".
  /// Lowercase letters/numbers/`_`/`.`, 3–20 chars. Optional until claimed.
  /// Stored already-lowercased so the unique constraint is case-insensitive.
  userTag         String?  @unique
  photoUrl        String?
  countryCode     String?
  coins           Int      @default(0)     // earned currency
  gems            Int      @default(0)     // purchased currency (IAP)
  proExpiresAt    DateTime?
  fcmTokens       String[] @default([])
  favouriteTeams  String[] @default([])
  /// Set to `now()` once the user dismisses the signup-gift reveal screen.
  /// While null, /v1/users/me surfaces the welcome card so the client can
  /// re-show the reveal after a reinstall (until the user actually sees it).
  welcomeCardSeenAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  predictions     Prediction[]
  bracket         Bracket?
  ownedCards      OwnedCard[]
  outgoingTrades  Trade[]    @relation("Initiator")
  incomingTrades  Trade[]    @relation("Recipient")
  achievements    UserAchievement[]
  notifications   NotificationLog[]
  iapReceipts     IapReceipt[]
  fantasyLineups  FantasyLineup[]
  challengesSent     H2HChallenge[] @relation("Challenger")
  challengesReceived H2HChallenge[] @relation("Opponent")
}

// ─────────────────────────────────────────────────────────────────────────────
// PREDICTIONS  (skill-based — no stakes, no wagering)
// ─────────────────────────────────────────────────────────────────────────────

model Prediction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId       String
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  homeScore     Int
  awayScore     Int
  pointsAwarded Int      @default(0)
  scoredAt      DateTime?
  createdAt     DateTime @default(now())
  @@unique([userId, matchId])
  @@index([matchId])
}

model Bracket {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId   String
  picks           Json                       // { "R16-1": "ARG", "R16-2": "FRA", ... "FINAL": "ARG" }
  lockedAt        DateTime?
  pointsAwarded   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// PANINI-STYLE CARD ALBUM  (earned, deterministic, halal)
// ─────────────────────────────────────────────────────────────────────────────
// CardTemplate = a defined card design (e.g. "Mbappé — France — WC2026 Base").
// OwnedCard    = a serial-numbered instance owned by a user.
// CardSet      = a collection users complete (e.g. "Argentina 26-man squad").
// No random monetary packs. Earn via play / ads / achievements. Direct IAP for
// SPECIFIC named cards or SPECIFIC named starter bundles only.

model CardTemplate {
  id            String      @id @default(cuid())
  playerId      String?
  player        Player?     @relation(fields: [playerId], references: [id])
  edition       String                       // "WC2026-BASE", "WC2026-GOLDEN-BOOT"
  rarity        CardRarity
  totalSupply   Int                          // hard cap; null = uncapped
  mintedCount   Int         @default(0)
  baseStats     Json                         // { pace, shot, pass, dribble, defence, physical }
  artUrl        String
  frameStyle    String      @default("base") // "base" | "holographic" | "trophy"
  giftableOnly  Boolean     @default(false)  // never purchasable, only earned/airdropped
  purchasable   Boolean     @default(false)  // direct gem purchase allowed?
  gemPrice      Int?                         // if purchasable
  setMemberships CardSetEntry[]
  ownedCards    OwnedCard[]
  globalCupPrizes GlobalCupPrize[]
  createdAt     DateTime    @default(now())
  @@index([edition, rarity])
}

enum CardRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  ICONIC
}

model OwnedCard {
  id            String       @id @default(cuid())
  templateId    String
  template      CardTemplate @relation(fields: [templateId], references: [id])
  serialNumber  Int                              // #347 of N
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  firstOwnerId  String                           // immutable provenance
  acquiredVia   AcquisitionSource
  mintedAt      DateTime     @default(now())
  cosmeticFrame String?                          // user-upgraded cosmetic
  @@unique([templateId, serialNumber])
  @@index([ownerId])
  @@index([templateId])
}

enum AcquisitionSource {
  DAILY_LOGIN
  PREDICTION_REWARD
  ACHIEVEMENT
  REWARDED_AD
  SET_COMPLETION
  TRADE
  DIRECT_PURCHASE
  ADMIN_GRANT
  /// Welcome gift minted on first sign-in (Common / Uncommon / Rare).
  SIGNUP_GIFT
}

model CardSet {
  id           String          @id @default(cuid())
  name         String                              // "Argentina — 26-man squad"
  description  String
  rewardCoins  Int             @default(0)
  rewardFrame  String?                             // cosmetic unlock on completion
  entries      CardSetEntry[]
  completions  SetCompletion[]
}

model CardSetEntry {
  id         String       @id @default(cuid())
  setId      String
  set        CardSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  templateId String
  template   CardTemplate @relation(fields: [templateId], references: [id])
  @@unique([setId, templateId])
}

model SetCompletion {
  id          String   @id @default(cuid())
  setId       String
  set         CardSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  userId      String
  completedAt DateTime @default(now())
  @@unique([setId, userId])
}

// Card-for-card barter only. No money side, no cash equivalent. Halal trade.
model Trade {
  id           String      @id @default(cuid())
  initiatorId  String
  initiator    User        @relation("Initiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User        @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  offered      Json                              // [{ ownedCardId }, ...]
  requested    Json
  status       TradeStatus @default(PENDING)
  message      String?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  @@index([recipientId, status])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// ACHIEVEMENTS, NEWS, IAP RECEIPTS, NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Achievement {
  id           String   @id              // "FIRST_PERFECT_PREDICTION"
  name         String
  description  String
  iconUrl      String?
  rewardCoins  Int      @default(0)
  rewardCardTemplateId String?
  users        UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())
  @@unique([userId, achievementId])
}

model NewsArticle {
  id          String   @id              // hash(url) — dedupes across feeds
  url         String   @unique
  title       String
  summary     String?
  source      String
  imageUrl    String?
  publishedAt DateTime
  tags        String[] @default([])
  teamIds     String[] @default([])
  fetchedAt   DateTime @default(now())
  @@index([publishedAt])
  @@index([source])
}

model IapReceipt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    String                           // "ios" | "android"
  productId   String                           // "gems_500" | "pro_monthly" | "card_messi_base"
  receiptB64  String                           // raw receipt for re-verification
  verifiedAt  DateTime?
  grantedAt   DateTime?
  amountUsd   Decimal? @db.Decimal(10,2)
  createdAt   DateTime @default(now())
  @@index([userId])
}

model NotificationLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String                           // "goal" | "kickoff" | "trade_offered" | ...
  payload     Json
  sentAt      DateTime @default(now())
  @@index([userId, sentAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// FANTASY  (free-to-play, skill-based — halal: no entry fees, prizes are cards)
// ─────────────────────────────────────────────────────────────────────────────
// Sorare 2022 Global Cup-style format:
//   - 8-player lineup: 2 GK, 2 DEF, 2 MID, 2 FWD
//   - 100-point budget
//   - 1 captain (2x points)
//   - Lock at gameweek deadline (kickoff of first match)

enum FantasyFormat {
  GLOBAL_CUP
  FRIENDLY
  H2H
}

enum PlayerPosition {
  GK
  DEF
  MID
  FWD
}

model FantasyTournament {
  id             String        @id @default(cuid())
  competitionId  String
  competition    Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name           String                                 // "WC 2026 Global Cup"
  slug           String        @unique                  // "wc2026-global-cup"
  format         FantasyFormat @default(GLOBAL_CUP)
  budget         Float         @default(100)
  description    String?
  emblemUrl      String?
  startsAt       DateTime
  endsAt         DateTime
  gameweeks      FantasyGameweek[]
  prizes         GlobalCupPrize[]
  challenges     H2HChallenge[]
  createdAt      DateTime      @default(now())
  @@index([competitionId])
}

model FantasyGameweek {
  id            String   @id @default(cuid())
  tournamentId  String
  tournament    FantasyTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number        Int                                     // 1, 2, 3...
  name          String                                  // "Matchday 1", "Round of 16"
  lockAt        DateTime                                // first kickoff
  endsAt        DateTime                                // last fulltime + grace
  matchIds      String[]  @default([])                  // matches scored in this gameweek
  scored        Boolean   @default(false)
  lineups       FantasyLineup[]
  playerScores  PlayerGameweekScore[]
  challenges    H2HChallenge[]
  @@unique([tournamentId, number])
  @@index([lockAt])
}

model PlayerValuation {
  id           String         @id @default(cuid())
  playerId     String         @unique
  player       Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  price        Float                                    // fraction of budget; e.g. 14.5
  recentForm   Float          @default(0)               // rolling avg fantasy points
  position     PlayerPosition
  updatedAt    DateTime       @updatedAt
  @@index([position, price])
}

model FantasyLineup {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameweekId    String
  gameweek      FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  picks         Json                                    // [{playerId, position, isCaptain}, ...]
  captainId     String
  budgetUsed    Float
  locked        Boolean  @default(false)
  totalPoints   Float    @default(0)
  rank          Int?
  scoredAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([userId, gameweekId])
  @@index([gameweekId, totalPoints])
}

model PlayerGameweekScore {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameweekId    String
  gameweek      FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  minutesPlayed Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  cleanSheet    Boolean  @default(false)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  saves         Int      @default(0)
  penaltyMisses Int      @default(0)
  ownGoals      Int      @default(0)
  goalsConceded Int      @default(0)
  bonusPoints   Int      @default(0)
  totalPoints   Float    @default(0)
  breakdown     Json
  updatedAt     DateTime @updatedAt
  @@unique([playerId, gameweekId])
  @@index([gameweekId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 1v1 HEAD-TO-HEAD CHALLENGES  (private duels, no money)
// ─────────────────────────────────────────────────────────────────────────────

enum H2HStatus {
  PENDING       // challenger sent, waiting on opponent
  ACCEPTED      // both ready, lineups submitted
  LOCKED        // gameweek deadline passed
  RESOLVED      // scored, winner set (or draw)
  DECLINED
  CANCELLED
}

model H2HChallenge {
  id                    String   @id @default(cuid())
  tournamentId          String
  tournament            FantasyTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  gameweekId            String
  gameweek              FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  challengerId          String
  challenger            User     @relation("Challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId            String
  opponent              User     @relation("Opponent",   fields: [opponentId],   references: [id], onDelete: Cascade)
  challengerLineupId    String?
  opponentLineupId      String?
  challengerScore       Float    @default(0)
  opponentScore         Float    @default(0)
  status                H2HStatus @default(PENDING)
  winnerId              String?
  message               String?
  createdAt             DateTime @default(now())
  resolvedAt            DateTime?
  @@index([opponentId, status])
  @@index([challengerId, status])
  @@index([gameweekId])
}

// ─────────────────────────────────────────────────────────────────────────────
// GLOBAL CUP PRIZES  (Sorare-style: rank tier → special edition card)
// ─────────────────────────────────────────────────────────────────────────────
// Defined-content prizes, not random — fully halal. Rank decides which TIER
// you fall into; within the tier, the named card template is awarded.

model GlobalCupPrize {
  id             String   @id @default(cuid())
  tournamentId   String
  tournament     FantasyTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rankFrom       Int                            // inclusive (e.g. 1)
  rankTo         Int                            // inclusive (e.g. 1 or 10 or 100)
  cardTemplateId String
  cardTemplate   CardTemplate @relation(fields: [cardTemplateId], references: [id])
  description    String                         // "Mythic — Final Champion's Card"
  awarded        Boolean  @default(false)
  awardedAt      DateTime?
  @@index([tournamentId, rankFrom])
}
