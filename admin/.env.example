# ─── Where the NestJS backend lives ─────────────────────────────────────
# Server-side fetches (SSR pages, route handlers) hit this URL. In a docker
# compose deploy this is usually the service name; locally it's localhost.
BACKEND_URL=http://localhost:3000

# Optionally exposed to the browser if you ever want client-side fetches
# to call the backend directly (we don't today — everything is proxied
# through Next.js so the auth cookie stays httpOnly).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# ─── Firebase Web App config ────────────────────────────────────────────
# All public-safe — these are the same values the mobile app uses. Pull
# them from Firebase console → Project settings → "Your apps" → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
