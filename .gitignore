# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related — patterns are root-agnostic so they catch the
# new app/ layout AND any future workspaces (e.g. admin/) without edits.
**/doc/api/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/

# Generated plugin registrant
**/lib/generated_plugin_registrant.dart

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages

# Secrets — present under app/ now that Flutter moved.
**/lib/secret.dart
**/android/app/google-services.json
**/android/local.properties
**/android/key.properties

# FVM version cache (whether at root or under app/)
**/.fvm/